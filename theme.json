{
    "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": false,
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "duotone": [],
            "gradients": [],
            "palette": [],
            "text": false,
            "background": false,
            "link": false
        },
        "typography": {
            "customFontSize": false,
            "defaultFontSizes": false,
            "dropCap": false,
            "fontSizes": [],
            "fontStyle": false,
            "fontWeight": false,
            "letterSpacing": false,
            "lineHeight": false,
            "textDecoration": false,
            "textTransform": false,
            "writingMode": false
        },
        "spacing": {
            "blockGap": false,
            "margin": false,
            "padding": false,
            "customSpacingSize": false,
            "defaultSpacingSizes": false
        },
        "layout": {
            "allowEditing": false,
            "allowCustomContentAndWideSize": false
        },
        "shadow": {
            "defaultPresets": false
        },
        "border": {
            "color": false,
            "radius": false,
            "style": false,
            "width": false
        }
    },
    "styles": {
        "spacing": {
            "blockGap": "0",
            "padding": {
                "top": "0",
                "right": "0",
                "bottom": "0",
                "left": "0"
            }
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--scheme-accent)",
                    "text": "var(--scheme-bg)"
                },
                "border": {
                    "radius": "0.5rem"
                },
                "typography": {
                    "fontFamily": "inherit",
                    "fontWeight": "600"
                },
                ":hover": {
                    "color": {
                        "background": "var(--scheme-accent-strong)",
                        "text": "var(--scheme-bg)"
                    }
                }
            },
            "link": {
                "color": {
                    "text": "var(--scheme-accent)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--scheme-accent-strong)"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
}
