{% set ratios = {equal: 'md:grid-flow-col md:auto-cols-fr', 'wide-start': 'md:grid-cols-[2fr_1fr]', 'wide-end': 'md:grid-cols-[1fr_2fr]'} %}
{% set gaps = {none: 'gap-0', small: 'gap-4', normal: 'gap-flow', large: 'gap-10'} %}
<div {{ block_wrapper_attributes({class: 'strata-columns grid grid-cols-1 ' ~ ratios[attrs.ratio.value] ~ ' ' ~ gaps[attrs.gap.value]}) }}{{ inner_blocks() }}>{{ content|raw }}</div>
