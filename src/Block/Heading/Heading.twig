{% set sizes = {1: 'text-4xl', 2: 'text-3xl', 3: 'text-2xl', 4: 'text-xl'} %}
{% set aligns = {start: 'text-start', center: 'text-center', end: 'text-end'} %}
<h{{ attrs.level.value }} {{ block_wrapper_attributes({class: 'strata-heading m-0 font-semibold leading-tight tracking-tight text-balance ' ~ sizes[attrs.level.value] ~ ' ' ~ aligns[attrs.textAlign.value]}) }}{{ field('text') }}>{{ attrs.text|raw }}</h{{ attrs.level.value }}>
