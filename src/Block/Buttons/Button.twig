{% set styles = {
    primary: 'bg-accent text-canvas hover:bg-accent-strong hover:text-canvas',
    secondary: 'border border-line-strong text-ink hover:border-accent hover:text-accent',
    text: 'px-0 text-accent underline underline-offset-4 hover:text-accent-strong',
} %}
<a {{ block_wrapper_attributes({class: 'strata-button inline-flex items-center rounded-control px-5 py-2.5 font-semibold no-underline transition-colors ' ~ styles[attrs.variant.value]}) }} {{ is_editor() ? '' : link_attributes(attrs.link) }}{{ field('label') }}>{{ attrs.label }}</a>
