<figure {{ block_wrapper_attributes({class: 'strata-quote m-0 border-s-4 border-accent ps-6'}) }}>
    <blockquote class="m-0 text-xl leading-snug"{{ field('text') }}>{{ attrs.text|raw }}</blockquote>
    {% if attrs.citation or is_editor() %}
        <figcaption class="mt-3 text-sm text-ink-soft"{{ field('citation') }}>{{ attrs.citation }}</figcaption>
    {% endif %}
</figure>
